{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CD Remote",
  "mainBinaryName": "cd-remote",
  "version": "1.1.0",
  "identifier": "com.formatocd.cd-remote",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CD Remote",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Modern cross-platform FTP, FTPS, SFTP & SSH client",
    "longDescription": "CD Remote is a lightweight, open-source cross-platform file transfer and SSH terminal client built with Rust, Tauri v2, and React.",
    "copyright": "Copyright (c) 2026 Carlos Durán (formatocd)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "./windows/installer.nsi",
        "languages": ["English", "Spanish", "Italian", "French", "German"],
        "displayLanguageSelector": true
      }
    }
  }
}
